# Copier ce fichier en .env.local (jamais commité) et renseigner les valeurs réelles.

# Base de données
MONGODB_URI=

# NextAuth — génère un secret avec `openssl rand -base64 32` (un par environnement).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email transactionnel (SMTP) — utilisé pour les codes de connexion client (OTP) et, à
# partir de la phase confirmation/paiement, pour les emails de commande/reçu.
# Important — EMAIL_FROM doit être sur le même domaine que SMTP_USER (donc authentifié par
# ce serveur). Un domaine différent (ex. blanchix.com si le serveur ne fait autorité que sur
# un autre domaine) échoue souvent silencieusement en réception (SPF/DKIM), même quand
# l'envoi lui-même réussit côté serveur.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Blanchix <votre-adresse@meme-domaine-que-smtp-user.com>"

# Paiement Mobile Money (MoneyFusion — Orange Money / MTN MoMo).
# URL de paiement complète fournie par le tableau de bord MoneyFusion pour votre application
# (elle inclut déjà l'identifiant d'application et la clé secrète), ex. :
# https://www.pay.moneyfusion.net/<votre-application>/<votre-cle>/pay/
MONEYFUSION_API_URL=
# Optionnel — à renseigner uniquement si MoneyFusion fournit un secret de vérification de
# webhook pour votre compte (non confirmé dans leur documentation publique à ce jour ; le
# serveur revérifie de toute façon chaque paiement via leur API avant de faire confiance à
# un webhook, voir src/lib/moneyfusion.ts).
MONEYFUSION_WEBHOOK_SECRET=

# Google Maps / Places — optionnel, saisie manuelle d'adresse utilisée tant qu'absent.
GOOGLE_MAPS_API_KEY=

# Notifications push (Web Push / VAPID) — génère une paire avec :
# node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:contact@votredomaine.com"
