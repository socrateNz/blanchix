
# Déploiement Docker sur Contabo — voir DEPLOY.md pour la procédure complète.

# Nom de domaine pointant vers ce VPS (DNS A record déjà configuré) — utilisé par nginx pour le
# certificat Let's Encrypt et le reverse proxy (voir nginx/templates/default.conf.template).
DOMAIN=

# MongoDB auto-hébergé dans le conteneur "mongo" (voir docker-compose.yml) — remplace
# MONGODB_URI (docker-compose.yml construit la chaîne de connexion à partir de ces identifiants,
# ne pas définir MONGODB_URI directement ici, il serait ignoré).
# MONGO_ROOT_* : compte administrateur Mongo (créé par l'image officielle au premier démarrage).
# MONGO_APP_* : compte applicatif dédié, droits limités à la base "blanchix" (voir
# mongo-init/create-app-user.js) — c'est celui-ci que l'app utilise réellement.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=blanchix_app
MONGO_APP_PASSWORD=

# NextAuth — génère un secret avec `openssl rand -base64 32` (un par environnement, ne JAMAIS
# réutiliser celui du dev local).
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://votre-domaine.com

# Email transactionnel (SMTP) — utilisé pour les codes de connexion client (OTP) et les emails
# de commande/reçu. Important — EMAIL_FROM doit être sur le même domaine que SMTP_USER (voir
# .env.example pour le détail du piège SPF/DKIM).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Blanchix <votre-adresse@meme-domaine-que-smtp-user.com>"

# Optionnel — met cette adresse en copie (bcc) de chaque email de confirmation de commande.
COMMANDE_COPIE_EMAIL=

# Paiement Mobile Money (Codees). Une fois en ligne sur ce domaine, mettre à jour l'URL de
# webhook déclarée côté tableau de bord marchand Codees vers
# https://votre-domaine.com/api/payments/webhook — jusqu'ici jamais joignable depuis un
# localhost de développement (voir mémoire de session : audit paiements du 2026-09-07).
CODEES_API_KEY=
CODEES_SECRET_KEY=

# Google Maps / Places — optionnel.
GOOGLE_MAPS_API_KEY=

# Notifications push (Web Push / VAPID) — NEXT_PUBLIC_VAPID_PUBLIC_KEY doit aussi être passé en
# build arg (voir docker-compose.yml, service "app") car il est inliné dans le bundle client au
# moment du build, pas lu au runtime.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:contact@votredomaine.com"

# Sécurise /api/cron/generate-slots — le conteneur "cron" envoie automatiquement ce secret,
# indispensable ici (contrairement à Vercel Cron, rien ne l'ajoute pour vous sur un VPS nu).
CRON_SECRET=
