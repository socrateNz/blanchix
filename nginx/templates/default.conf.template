# Reverse proxy : seul point d'entrée public (80/443), tout le reste (app, mongo, cron) reste
# sur le réseau Docker interne.
#
# Placé dans /etc/nginx/templates/ (convention de l'image officielle nginx depuis 1.19) : au
# démarrage du conteneur, l'entrypoint applique automatiquement `envsubst` sur ce fichier et
# écrit le résultat dans /etc/nginx/conf.d/default.conf — ${DOMAIN} est donc bien remplacé par
# la vraie valeur de la variable d'environnement du même nom (voir docker-compose.yml), aucune
# édition manuelle du fichier n'est nécessaire.

server {
    listen 80;
    server_name ${DOMAIN};

    # Nécessaire pour la validation ACME (Let's Encrypt) — doit rester accessible en HTTP même
    # une fois HTTPS activé, pour les renouvellements automatiques.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Consommés par requireAdmin()/logAudit() (adresseIP) et par NextAuth pour reconstruire
        # l'URL — sans ces en-têtes, l'app verrait toujours 127.0.0.1 et http:// en interne.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
